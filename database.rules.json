{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid && $code.matches(/^[A-HJ-NP-Z2-9]{6}$/)) || data.child('host').val() === auth.uid)",
        ".validate": "newData.hasChildren(['host','createdAt','expiresAt','state']) && newData.child('host').isString() && newData.child('expiresAt').isNumber()",
        "host": {
          ".read": "auth != null",
          ".validate": "!data.exists() || newData.val() === data.val()"
        },
        "state": {
          ".read": "auth != null && now < data.parent().child('expiresAt').val()"
        },
        "members": {
          ".read": "auth != null && auth.uid === data.parent().child('host').val()",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('host').exists() && now < root.child('rooms').child($code).child('expiresAt').val()",
            ".validate": "newData.hasChildren(['name','avatar','colour','team','audience']) && newData.child('name').isString() && newData.child('name').val().length <= 18 && newData.child('name').val().length > 0 && newData.child('audience').isBoolean()",
            "$other": {
              ".validate": "$other === 'name' || $other === 'avatar' || $other === 'colour' || $other === 'team' || $other === 'audience'"
            }
          }
        },
        "inputs": {
          ".read": "auth != null && auth.uid === data.parent().child('host').val()",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('members').child($uid).exists() && now < root.child('rooms').child($code).child('expiresAt').val()",
            ".validate": "newData.hasChildren(['id','type']) && newData.child('id').isString() && newData.child('type').isString()",
            "$other": {
              ".validate": "$other === 'id' || $other === 'type' || $other === 'activityId' || $other === 'value' || $other === 'card'"
            }
          }
        },
        "feedback": { "$uid": { ".read": "auth != null && auth.uid === $uid" } }
      }
    }
  }
}
